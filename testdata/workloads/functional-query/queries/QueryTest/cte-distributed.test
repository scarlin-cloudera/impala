---- QUERY
WITH v1 AS (SELECT n_name, n_nationkey FROM tpch.nation WHERE n_regionkey = 0)
SELECT v1.n_name, v1_next.n_name FROM v1, v1 v1_next WHERE v1.n_nationkey + 1 = v1_next.n_nationkey;
---- RESULTS: VERIFY_IS_EQUAL
'KENYA','MOROCCO'
'MOROCCO','MOZAMBIQUE'
---- TYPES
STRING, STRING
====
---- QUERY
CREATE TABLE emps (empid INT, deptno INT, name STRING, salary DECIMAL(8, 2));
---- RESULTS
'Table has been created.'
====
---- QUERY
INSERT INTO emps VALUES
    (1, 1, "Phil", 45000.0), (2, 1, "Maggie", 55000.0), (3, 2, "Alice", 120000.0);
---- RESULTS
