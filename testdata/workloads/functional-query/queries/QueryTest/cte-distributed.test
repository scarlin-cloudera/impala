# Verify Calcite plan to ensure CTEs are present
     ImpalaSequence
       ImpalaProjectRel(C_NAME=[$0], EXPR$1=[$1])
         ImpalaSortRel(sort0=[$2], sort1=[$3], sort2=[$4], dir0=[DESC], dir1=[ASC], dir2=[ASC], fetch=[10:TINYINT])
           ImpalaProjectRel(C_NAME=[$0], EXPR$1=[$5], o_totalprice=[$4], o_orderdate=[$3], o_orderkey=[$2])
             ImpalaAggRel(group=[{0, 1, 2, 3, 4}], EXPR$1=[SUM($5)])
               ImpalaProjectRel(C_NAME=[$1], c_custkey=[$0], o_orderkey=[$4], o_orderdate=[$7], o_totalprice=[$6], l_quantity=[$3])
                 ImpalaJoinRel(condition=[=($0, $5)], joinType=[inner])
                   ImpalaFilterRel(condition=[IS NOT NULL($0)])
                     ImpalaProjectRel(c_custkey=[$0], c_name=[$1])
                       ImpalaHdfsScanRel(table=[[tpch, customer]])
                   ImpalaJoinRel(condition=[=($2, $0)], joinType=[inner])
                     ImpalaFilterRel(condition=[IS NOT NULL($0)])
                       ImpalaCTEConsumer(cteName=[cte_suggestion_0])
                     ImpalaJoinRel(condition=[=($0, $4)], joinType=[inner])
                       ImpalaFilterRel(condition=[AND(IS NOT NULL($0), IS NOT NULL($1))])
                         ImpalaProjectRel(o_orderkey=[$0], o_custkey=[$1], o_totalprice=[$3], o_orderdate=[$4])
                           ImpalaHdfsScanRel(table=[[tpch, orders]])
                       ImpalaProjectRel(L_ORDERKEY=[$0])
                         ImpalaFilterRel(condition=[>($1, 300.00)])
                           ImpalaAggRel(group=[{0}], agg#0=[SUM($1)])
                             ImpalaFilterRel(condition=[IS NOT NULL($0)])
                               ImpalaCTEConsumer(cteName=[cte_suggestion_0])
       ImpalaCTEProducer(readType=[EAGER], writeType=[EAGER], cteName=[cte_suggestion_0])
         ImpalaFilterRel(condition=[>($1, 0.00)])
           ImpalaProjectRel(l_orderkey=[$0], l_quantity=[$4])
             ImpalaHdfsScanRel(table=[[tpch, lineitem]])
# Runtime filters on 04:CTE CONSUMER
     |  04:CTE CONSUMER [cte_suggestion_0]
     |  |  runtime filters: RF003[min_max] -> l_orderkey, RF002[bloom] -> l_orderkey
# Verify Final filter table:
#     ID  Src. Node  Tgt. Node(s)  Eff. Tgt. Node(s)  Target type
#    ------------------------------------------------------------
#      2         11             4                  4       REMOTE
#      3         11             4                  N       REMOTE
row_regex: 2\s+11\s+4\s+4\s+REMOTE
row_regex: 3\s+11\s+4\s+N\s+REMOTE
